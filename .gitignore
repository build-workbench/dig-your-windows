## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
artifacts/
publish/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# MSTest / VSTest test Results and Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage/
*.trx
*.coverage


# NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/

# Node (VitePress docs)
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Others
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
CLAUDE.local.md

# Project worktrees
.worktrees/

# OMC (oh-my-claudecode) state
.omc/

# CommandCode state
.commandcode/

# Temporary audit files
PHASE1_AUDIT_FINDINGS.md
