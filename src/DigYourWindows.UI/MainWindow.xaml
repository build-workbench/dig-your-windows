<ui:FluentWindow x:Class="DigYourWindows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:DigYourWindows.UI.Views"
        mc:Ignorable="d"
        Title="DigYourWindows - Windows 深度诊断工具"
        Height="900" Width="1400"
        MinWidth="1000" MinHeight="650"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Clean Modern Windows 11 Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="DigYourWindows">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="6,1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion, FallbackValue='v1.2.0'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="深度系统诊断与健康评估平台" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Modern Windows 11 Fluent Navigation View -->
        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           CompactPaneLength="48">
            <ui:NavigationView.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </ui:NavigationView.LayoutTransform>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="系统仪表盘"
                    Icon="{ui:SymbolIcon Home24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:DashboardPage}"/>

                <ui:NavigationViewItem
                    Content="实时监控与走势"
                    Icon="{ui:SymbolIcon ChartMultiple24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:MonitoringPage}"/>

                <ui:NavigationViewItem
                    Content="事件与日志"
                    Icon="{ui:SymbolIcon ErrorCircle24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:LogsPage}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge Value="{Binding PerformanceAnalysis.WarningsCount}" Severity="Caution"/>
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem
                    Content="硬件设备详情"
                    Icon="{ui:SymbolIcon HardDrive24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:HardwarePage}"/>

                <ui:NavigationViewItem
                    Content="诊断历史档案"
                    Icon="{ui:SymbolIcon ClipboardClock24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:HistoryPage}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="切换深浅主题"
                    Icon="{ui:SymbolIcon WeatherMoon24}"
                    Command="{Binding ToggleThemeCommand}"/>

                <ui:NavigationViewItem
                    Content="界面与字体设置"
                    Icon="{ui:SymbolIcon Settings24}"
                    Click="OpenSettingsClicked"/>
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.PaneFooter>
                <Border Margin="12,0,12,6">
                    <TextBlock Text="{Binding AppVersion, StringFormat='版本 {0}', FallbackValue='版本 v1.2.0'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
            </ui:NavigationView.PaneFooter>
        </ui:NavigationView>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Height="32" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:ProgressRing Grid.Column="0"
                                IsIndeterminate="True"
                                Width="16" Height="16"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <TextBlock Grid.Column="1"
                          Text="{Binding StatusMessage}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                <TextBlock Grid.Column="2"
                          Text="{Binding AppVersion, StringFormat='DigYourWindows {0}', FallbackValue='DigYourWindows v1.2.0'}"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
