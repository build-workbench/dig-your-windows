<Page x:Class="DigYourWindows.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1100"
      Title="系统仪表盘">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32">
            <!-- Header Section with Modern Fluent Action Toolbar -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="系统概览与健康仪表盘" FontSize="26" FontWeight="Bold"/>
                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion, FallbackValue='v1.2.0'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="实时汇总系统核心硬件、运行稳定性与综合健康度多维评估" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Modern Toolbar Pill -->
                <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="8,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="采样周期" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="6,0,6,0"/>
                        <ComboBox ItemsSource="{Binding AvailableDays}"
                                  SelectedItem="{Binding SelectedDaysBack}"
                                  Width="70" Height="30" FontSize="12"
                                  Margin="0,0,8,0"/>

                        <ui:Button Content="刷新诊断"
                                   Command="{Binding LoadDataCommand}"
                                   Icon="{ui:SymbolIcon ArrowRotateClockwise20}"
                                   Appearance="Primary"
                                   Height="30" Padding="12,0" FontSize="12"
                                   Margin="0,0,6,0"/>

                        <ui:DropDownButton Content="导出报告"
                                           Icon="{ui:SymbolIcon DocumentArrowUp20}"
                                           Height="30" Padding="10,0" FontSize="12"
                                           Margin="0,0,6,0">
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <MenuItem Header="导出 HTML 诊断报告" Command="{Binding ExportToHtmlCommand}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Document20"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="导出 JSON 原始数据" Command="{Binding ExportToJsonCommand}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Code20"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>

                        <ui:Button Content="导入 JSON"
                                   Command="{Binding ImportFromJsonCommand}"
                                   Icon="{ui:SymbolIcon DocumentArrowDown20}"
                                   Height="30" Padding="10,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Info 4 Cards with Modern Icon Plates -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Computer Name -->
                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#180078D4" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="22" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="计算机名" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding HardwareInfo.ComputerName, Converter={StaticResource NullToPlaceholderConverter}, ConverterParameter=未知}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="本地工作站" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- CPU -->
                <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#188A2BE2" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="22" Foreground="#8A2BE2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="处理器 (CPU)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding HardwareInfo.CpuName, Converter={StaticResource NullToPlaceholderConverter}, ConverterParameter=未知}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="{Binding HardwareInfo.CpuCores, Mode=OneWay}"/>
                                <Run Text=" 逻辑核心"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Memory -->
                <ui:Card Grid.Column="2" Margin="4,0,4,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1800B894" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Ram20" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="物理内存" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0">
                                <Run Text="{Binding HardwareInfo.TotalMemoryMB, Converter={StaticResource MegabytesToGigabytesConverter}, Mode=OneWay}"/>
                                <Run Text=" GB"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="可用 "/>
                                <Run Text="{Binding HardwareInfo.AvailableMemoryMB, Converter={StaticResource MegabytesToGigabytesConverter}, Mode=OneWay}"/>
                                <Run Text=" GB"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- OS -->
                <ui:Card Grid.Column="3" Margin="8,0,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#180078D4" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="WindowApps24" FontSize="22" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="操作系统" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding HardwareInfo.OsVersion, Converter={StaticResource NullToPlaceholderConverter}, ConverterParameter=Windows}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock Text="64 位操作系统" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Health & Scores Section -->
            <TextBlock Text="健康评估与评分矩阵" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,14"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Overall Health Score Radial Ring Card -->
                <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="20">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Radial Ring with Track and Inner Hero Score -->
                        <Grid Grid.Row="0" Width="150" Height="150" HorizontalAlignment="Center">
                            <Border Width="150" Height="150" CornerRadius="75" BorderThickness="11" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>

                            <ui:ProgressRing
                                Progress="{Binding PerformanceAnalysis.SystemHealthScore, Mode=OneWay}"
                                IsIndeterminate="False"
                                Width="150" Height="150"
                                Foreground="{Binding PerformanceAnalysis.HealthColor, Converter={StaticResource StringToBrushConverter}}"/>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock
                                    Text="{Binding PerformanceAnalysis.SystemHealthScore, StringFormat='{}{0:F0}', Mode=OneWay}"
                                    FontSize="44"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding PerformanceAnalysis.HealthColor, Converter={StaticResource StringToBrushConverter}}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{Binding PerformanceAnalysis.HealthColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" CornerRadius="10" Padding="12,2" Margin="0,4,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PerformanceAnalysis.HealthGrade}" FontWeight="Bold" FontSize="12" Foreground="{Binding PerformanceAnalysis.HealthColor, Converter={StaticResource StringToBrushConverter}}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="系统综合健康指数" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </Grid>
                </ui:Card>

                <!-- 4 Sub-score Cards with Dedicated Themed Colors in 2x2 Grid -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stability Score -->
                    <ui:Card Grid.Row="0" Grid.Column="0" Margin="0,0,7,7" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="#183B82F6" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark20" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="稳定性评分" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="基于蓝屏与应用崩溃记录" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding PerformanceAnalysis.StabilityScore, StringFormat='{}{0:F0}', Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    <Run Text=" 分" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding PerformanceAnalysis.StabilityScore, Mode=OneWay}" Foreground="#3B82F6" Maximum="100" Height="5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Performance Score -->
                    <ui:Card Grid.Row="0" Grid.Column="1" Margin="7,0,0,7" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="#188A2BE2" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="DeveloperBoard20" Foreground="#B18CFE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="性能表现评分" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="基于 CPU 规格与运行负载" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding PerformanceAnalysis.PerformanceScore, StringFormat='{}{0:F0}', Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    <Run Text=" 分" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding PerformanceAnalysis.PerformanceScore, Mode=OneWay}" Foreground="#8A2BE2" Maximum="100" Height="5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Memory Score -->
                    <ui:Card Grid.Row="1" Grid.Column="0" Margin="0,7,7,0" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="#1800B894" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="Ram20" Foreground="#2ED573" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="内存健康评分" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="基于可用内存余量与占用率" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding PerformanceAnalysis.MemoryUsageScore, StringFormat='{}{0:F0}', Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    <Run Text=" 分" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding PerformanceAnalysis.MemoryUsageScore, Mode=OneWay}" Foreground="#00B894" Maximum="100" Height="5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- Disk Health Score -->
                    <ui:Card Grid.Row="1" Grid.Column="1" Margin="7,7,0,0" Padding="14">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="6" Background="#18E67E22" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="HardDrive20" Foreground="#FFA502" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="存储健康评分" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="基于 SMART 寿命与分区余量" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Run Text="{Binding PerformanceAnalysis.DiskHealthScore, StringFormat='{}{0:F0}', Mode=OneWay}" FontSize="20" FontWeight="Bold"/>
                                    <Run Text=" 分" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </TextBlock>
                            </Grid>
                            <ProgressBar Value="{Binding PerformanceAnalysis.DiskHealthScore, Mode=OneWay}" Foreground="#E67E22" Maximum="100" Height="5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </Grid>

            <!-- Metrics & Live Indicators -->
            <TextBlock Text="运行状态与指标快照" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,14"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Critical Issues -->
                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#18107C41" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="CheckmarkCircle20" FontSize="20" Foreground="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="严重问题" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <Run Text="{Binding PerformanceAnalysis.CriticalIssuesCount, StringFormat='{}{0}', Mode=OneWay}"/>
                                <Run Text=" 项" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="系统运行健康" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Warnings -->
                <ui:Card Grid.Column="1" Margin="4,0,4,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#18FFA502" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="{DynamicResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="潜在警告" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding PerformanceAnalysis.WarningsCount, StringFormat='{}{0}', Mode=OneWay}"/>
                                <Run Text=" 项" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="常规良性事件" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- System Uptime -->
                <ui:Card Grid.Column="2" Margin="4,0,4,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#180078D4" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="连续开机时间" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock FontSize="20" FontWeight="Bold" Margin="0,2,0,0">
                                <Run Text="{Binding PerformanceAnalysis.SystemUptimeDays, Converter={StaticResource NullableDoubleToStringConverter}, ConverterParameter=F1, Mode=OneWay}"/>
                                <Run Text=" 天" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="系统平稳在线" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- CPU Live Snapshot -->
                <ui:Card Grid.Column="3" Margin="8,0,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#18FF4757" Margin="0,0,12,0">
                            <ui:SymbolIcon Symbol="HeartPulse24" FontSize="20" Foreground="{DynamicResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CPU 实时状态" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CpuInfo.Load, Converter={StaticResource NaNSafeConverter}, ConverterParameter=F0}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="%" FontSize="13" VerticalAlignment="Bottom" Margin="1,0,8,1"/>
                                <TextBlock Text="{Binding CpuInfo.Temperature, Converter={StaticResource ZeroAsMissingConverter}, ConverterParameter=F1}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="°C" FontSize="12" VerticalAlignment="Bottom" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="1,0,0,1"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="{Binding CpuInfo.Clock, Converter={StaticResource NaNSafeConverter}, ConverterParameter=F0, Mode=OneWay}"/>
                                <Run Text=" MHz"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- Recommendations Card -->
            <ui:Card Visibility="{Binding PerformanceAnalysis.Recommendations.Count, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,4,0,0" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Lightbulb24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="诊断建议与优化措施" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="基于 Windows 遥测与日志推导的优化建议" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PerformanceAnalysis.Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
