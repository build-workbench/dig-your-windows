<ui:FluentWindow x:Class="DigYourWindows.UI.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="偏好设置"
        Icon="/Assets/app.ico"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="偏好设置" ShowMaximize="False" ShowMinimize="False" Icon="{ui:SymbolIcon Settings24}"/>

        <StackPanel Grid.Row="1" Margin="28,16,28,24">
            <TextBlock Text="界面外观与排版" FontSize="16" FontWeight="SemiBold"/>

            <TextBlock Text="界面字体" Margin="0,16,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="FontComboBox"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="FontName"/>

            <TextBlock Text="界面缩放" Margin="0,14,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <ComboBox x:Name="ScaleComboBox"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                <ui:Button Content="应用保存" Appearance="Primary" Click="OnOkClicked" MinWidth="88"/>
                <ui:Button Content="取消" Margin="10,0,0,0" Click="OnCancelClicked" MinWidth="88"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
