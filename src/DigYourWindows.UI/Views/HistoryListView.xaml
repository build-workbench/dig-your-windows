<UserControl
    x:Class="DigYourWindows.UI.Views.HistoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid>
        <StackPanel Orientation="Vertical">
            <!-- Empty State -->
            <TextBlock
                x:Name="EmptyStateText"
                Text="无可用的诊断历史记录。"
                Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,8" />

            <!-- Loading State -->
            <TextBlock
                Text="正在加载历史记录..."
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,8" />

            <!-- History List -->
            <ListBox
                x:Name="HistoryListBox"
                ItemsSource="{Binding HistoryEntries}"
                SelectedItem="{Binding SelectedEntry}"
                Visibility="{Binding IsHistoryEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Background="Transparent"
                BorderThickness="0"
                Margin="0,4">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Friendly automation name instead of the record's ToString dump -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding ComputerName}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12,8"
                            Margin="0,3"
                            CornerRadius="4"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Orientation="Vertical">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ComputerName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding CollectedAtUtc, StringFormat='yyyy-MM-dd HH:mm'}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding HealthGrade, StringFormat='健康等级 {0}'}"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" />
                                    <TextBlock Text="{Binding SystemHealthScore, StringFormat='健康评分 {0:F1}'}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
