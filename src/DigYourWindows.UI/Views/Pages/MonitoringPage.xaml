<Page x:Class="DigYourWindows.UI.Views.Pages.MonitoringPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1100"
      Title="实时监控与走势">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">
            <!-- Header Section -->
            <TextBlock Text="实时监控与趋势图表" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="动态追踪网络吞吐走势、系统可靠性历史变化及显卡实时负载" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>

            <!-- Network Traffic Section -->
            <ui:CardExpander Header="网络流量监控" Icon="{ui:SymbolIcon ArrowTrendingLines24}" IsExpanded="True" Margin="0,0,0,16">
                <StackPanel Margin="10">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Card Grid.Column="0" Margin="0,0,6,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#180078D4" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="当前下载速率" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock FontSize="22" FontWeight="Bold" Margin="0,2,0,0">
                                        <Run Text="{Binding NetworkDownloadMBps, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                        <Run Text=" MB/s" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <ui:Card Grid.Column="1" Margin="6,0,0,0" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#1800B894" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="20" Foreground="#00B894" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="当前上传速率" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock FontSize="22" FontWeight="Bold" Margin="0,2,0,0">
                                        <Run Text="{Binding NetworkUploadMBps, StringFormat='{}{0:F2}', Mode=OneWay}"/>
                                        <Run Text=" MB/s" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6">
                        <ContentControl Content="{Binding NetworkTrafficPlot, Mode=OneTime}" Height="230"/>
                    </Border>
                </StackPanel>
            </ui:CardExpander>

            <!-- Reliability Trend Section -->
            <ui:CardExpander Header="系统可靠性走势" Icon="{ui:SymbolIcon ChartMultiple24}" IsExpanded="True" Margin="0,0,0,16">
                <Grid Margin="10">
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6"
                            Visibility="{Binding ReliabilityRecords.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ContentControl Content="{Binding ReliabilityTrendPlot, Mode=OneTime}" Height="230"/>
                    </Border>
                    <ui:Card Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding ReliabilityRecords.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="50" Height="50" CornerRadius="12" Background="#182ED573" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="ChartMultiple24" FontSize="26" Foreground="#2ED573" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="暂无可靠性趋势数据" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Windows 稳定性监视器尚未产生可绘制的历史记录。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </ui:CardExpander>

            <!-- GPU Monitoring Section -->
            <ui:CardExpander Icon="{ui:SymbolIcon ShieldTask24}" IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Header>
                    <TextBlock>
                        <Run Text="GPU 图形处理器监控 ("/>
                        <Run Text="{Binding HardwareInfo.Gpus.Count, Mode=OneWay}"/>
                        <Run Text=" 个设备)"/>
                    </TextBlock>
                </ui:CardExpander.Header>
                <StackPanel Margin="10">
                    <ItemsControl ItemsSource="{Binding HardwareInfo.Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,4" Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                            <ui:SymbolIcon Symbol="Video24" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Temperature -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="核心温度" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                                                    <Run Text="{Binding Temperature, Converter={StaticResource ZeroAsMissingConverter}, ConverterParameter=F1, Mode=OneWay}"/>
                                                    <Run Text="°C" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Load -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="核心负载" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Load, Converter={StaticResource NaNSafeConverter}, ConverterParameter=F1}" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="%" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- VRAM -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="显存占用 (VRAM)" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0">
                                                    <Run Text="{Binding MemoryUsed, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                    <Run Text="/" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                    <Run Text="{Binding MemoryTotal, StringFormat='{}{0:F0}', Mode=OneWay}"/>
                                                    <Run Text=" MB" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Power -->
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="实时功耗" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Power, Converter={StaticResource ZeroAsMissingConverter}, ConverterParameter=F1}" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="W" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="未检测到独立 GPU 传感器数据"
                               HorizontalAlignment="Center" Margin="0,10"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HardwareInfo.Gpus.Count, Converter={StaticResource InverseCountToVisibilityConverter}}"/>
                </StackPanel>
            </ui:CardExpander>

            <!-- Top Processes Section -->
            <ui:CardExpander Header="进程资源占用 TOP 10" Icon="{ui:SymbolIcon TaskListSquareLtr24}" IsExpanded="False" Margin="0,0,0,16">
                <StackPanel Margin="10">
                    <TextBlock Text="按 CPU 使用率排序（首次采样后生效），CPU 百分比已按逻辑核心数归一化"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding TopProcesses}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             RowHeight="30"
                             MaxHeight="360"
                             Background="Transparent"
                             RowBackground="Transparent"
                             AlternatingRowBackground="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="CPU" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Width="80" Height="5" Foreground="#0078D4"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="内存" Binding="{Binding MemoryMB, StringFormat='{}{0:F0} MB'}" Width="110"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
