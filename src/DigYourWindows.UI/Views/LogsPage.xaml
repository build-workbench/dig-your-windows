<Page x:Class="DigYourWindows.UI.Views.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1100"
      Title="事件与可靠性日志">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,28">
            <!-- Header Section -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="系统可靠性与错误日志" FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="查看最近 "/>
                    <Run Text="{Binding SelectedDaysBack, Mode=OneWay}"/>
                    <Run Text=" 天内记录的 Windows 系统事件、应用故障与崩溃信息"/>
                </TextBlock>
            </StackPanel>

            <!-- Section 1: System Events & Errors -->
            <ui:CardExpander Icon="{ui:SymbolIcon ErrorCircle24}" IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="系统错误与警告日志" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:InfoBadge Value="{Binding EventLogEntries.Count, Mode=OneWay}" Severity="Attention" Margin="10,0,0,0"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding EventLogEntries}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             RowHeight="36"
                             MaxHeight="450">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="发生时间" Binding="{Binding TimeGenerated, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                            <DataGridTextColumn Header="级别类型" Binding="{Binding EventType}" Width="100"/>
                            <DataGridTextColumn Header="事件来源" Binding="{Binding Source}" Width="180"/>
                            <DataGridTextColumn Header="日志内容" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:CardExpander>

            <!-- Section 2: Reliability Records -->
            <ui:CardExpander Icon="{ui:SymbolIcon History24}" IsExpanded="True" Margin="0,0,0,16">
                <ui:CardExpander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="系统可靠性与崩溃记录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:InfoBadge Value="{Binding ReliabilityRecords.Count, Mode=OneWay}" Margin="10,0,0,0"/>
                    </StackPanel>
                </ui:CardExpander.Header>
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding ReliabilityRecords}"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             HeadersVisibility="Column"
                             GridLinesVisibility="Horizontal"
                             RowHeight="36"
                             MaxHeight="350"
                             Visibility="{Binding ReliabilityRecords.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="发生时间" Binding="{Binding TimeGenerated, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160"/>
                            <DataGridTextColumn Header="产品 / 程序" Binding="{Binding ProductName}" Width="200"/>
                            <DataGridTextColumn Header="故障类型" Binding="{Binding RecordTypeDescription}" Width="120"/>
                            <DataGridTextColumn Header="详细描述" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:Card Padding="32" Visibility="{Binding ReliabilityRecords.Count, Converter={StaticResource InverseCountToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="50" Height="50" CornerRadius="12" Background="#182ED573" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="26" Foreground="#2ED573" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="暂无系统级严重可靠性崩溃记录" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Windows 稳定性监视器未检测到软件挂起、驱动程序崩溃或严重系统硬件中断。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
